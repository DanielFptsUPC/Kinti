# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# backend (Python)
backend/.venv/
backend/.env
# Certificados y credenciales de servicios externos
backend/*.crt
backend/*.json
!backend/tests/**/*.json
# La CA raíz de Supabase es un certificado PÚBLICO, no un secreto: se publica en
# su dashboard. Debe versionarse para que el despliegue pueda verificar TLS.
!backend/supabase-ca.crt
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
