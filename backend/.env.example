# Copia este archivo como `.env` y ajusta los valores para tu entorno local.
# NINGUNO de estos valores debe usarse en un entorno real: el piloto usa datos sintéticos.

# PostgreSQL del piloto. `docker compose up -d db` publica el puerto 5433.
KINTI_DATABASE_URL=postgresql+asyncpg://kinti:kinti@localhost:5433/kinti

# Secreto de firma JWT del piloto. Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KINTI_JWT_SECRET=cambia-este-secreto-solo-para-desarrollo-local

KINTI_ACCESS_TOKEN_MINUTES=30
KINTI_REFRESH_TOKEN_DAYS=14

# Ventana simulada antes de que una barrera abierta escale a rojo.
KINTI_BARRIER_RESPONSE_WINDOW_HOURS=48

# Tolerancia tras la hora programada antes de marcar un hito como inasistencia.
KINTI_MISSED_TOLERANCE_HOURS=6

# Orígenes permitidos por CORS, separados por coma.
KINTI_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Contraseña de las cuentas sintéticas que crea `python -m app.seed`.
KINTI_SEED_PASSWORD=Kinti.Demo.2026

# `local` habilita utilidades de desarrollo (por ejemplo, restaurar la demo).
KINTI_ENVIRONMENT=local

# --------------------------------------------------------------- Fase 3
# Conexión directa para Alembic, dumps y administración. Vacío = usa la de runtime.
KINTI_MIGRATION_DATABASE_URL=

# Proveedor de IA. `fake` por defecto a propósito: un despliegue mal configurado
# no debe empezar a gastar dinero ni a enviar datos a un tercero por omisión.
# Ver docs/VERTEX_AI_ACTIVACION.md para activar `vertex`.
KINTI_AI_PROVIDER=fake
# Proyecto de GCP explícito: el SDK puede inferirlo de GOOGLE_CLOUD_PROJECT,
# pero eso dejaría el proveedor apuntando a "lo que sea que haya en el entorno".
KINTI_AI_PROJECT=
# Identificador GA explícito. NO se admite el alias `latest`: un modelo que
# cambia bajo los pies invalida toda evaluación previa.
KINTI_AI_MODEL_ID=
KINTI_AI_REGION=
KINTI_AI_TIMEOUT_SECONDS=30
KINTI_AI_MAX_OUTPUT_TOKENS=1024

# Credencial de la service account de Vertex AI, como ruta a un archivo JSON
# (nunca el JSON pegado directamente aquí). En local, apunta a un archivo fuera
# del repositorio; en Render, `docker-entrypoint.sh` lo materializa desde
# GOOGLE_APPLICATION_CREDENTIALS_JSON antes de arrancar.
GOOGLE_APPLICATION_CREDENTIALS=

KINTI_EMBEDDING_PROVIDER=fake
KINTI_EMBEDDING_MODEL_ID=
# Cambiar la dimensión exige reindexado versionado: mezclar vectores de
# dimensiones distintas es un error de datos, no una degradación.
KINTI_EMBEDDING_DIMENSION=768

KINTI_RAG_TOP_K=5

# `local` usa almacenamiento en memoria; `supabase` requiere las dos variables.
KINTI_STORAGE_PROVIDER=local
KINTI_SUPABASE_URL=
KINTI_SUPABASE_SERVICE_KEY=

# Límites de medios conversacionales.
KINTI_MAX_AUDIO_SECONDS=120
KINTI_MAX_MEDIA_BYTES=10485760
KINTI_MEDIA_RETENTION_HOURS=24

# Pool de conexiones. Ajustar al límite real del plan contratado.
KINTI_DB_POOL_SIZE=5
KINTI_DB_MAX_OVERFLOW=5
KINTI_DB_POOL_TIMEOUT=30
KINTI_DB_POOL_RECYCLE=1800

# Exige TLS con certificado verificado. Obligatorio contra una base administrada.
# En el PostgreSQL local en contenedor se deja en false: no hay certificado.
KINTI_REQUIRE_TLS=false

# --------------------------------------------------------------- Fase 5
# Kinti Voz arranca siempre con adaptadores deterministas. Activar un proveedor
# real requiere credenciales, presupuesto, retención aprobada y un backend
# always-on; el plan gratuito de Render no garantiza latencia de webhook.
KINTI_TELEPHONY_PROVIDER=fake
KINTI_VOICE_MODE=turn
KINTI_VOICE_LANGUAGE=es-PE
KINTI_VOICE_DEFAULT_SPEECH_RATE=slow
KINTI_VOICE_MAX_CALL_SECONDS=480
KINTI_VOICE_MAX_REPROMPTS=2
KINTI_VOICE_RECORDING_ENABLED=false
KINTI_VOICE_TRANSCRIPT_RETENTION_ENABLED=false
KINTI_VOICE_CALLBACK_ENABLED=true

KINTI_REFERRAL_PROVIDER=fake
KINTI_SCHEDULING_PROVIDER=fake
KINTI_STT_PROVIDER=fake
KINTI_TTS_PROVIDER=fake

# Secreto sólo para firmar webhooks del simulador/fake. Genere uno distinto por
# entorno. No se usa para autenticar al cuidador.
KINTI_TELEPHONY_WEBHOOK_SECRET=cambia-este-secreto-de-webhook

# Vacíos por defecto: el adaptador se valida por contrato, pero el runtime
# bloquea Twilio hasta conectar workflow durable, gateways institucionales,
# backend always-on y autorización explícita.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
